# Environment variables for the local development environment
ENV=local
LOG_FORMAT=text
LOG_LEVEL=debug
APP_RELOAD=True
APP_DEBUG=True
JBI_API_KEY="fake_api_key"
DL_QUEUE_DSN=file:///tmp/dlqueue
DL_QUEUE_CONSTANT_RETRY=true
DL_QUEUE_RETRY_TIMEOUT_DAYS=7

# Jira API Secrets
JIRA_USERNAME="fake_jira_username"
JIRA_API_KEY="fake_jira_api_key"

# Bugzilla API Secrets
BUGZILLA_API_KEY="fake_bugzilla_api_key"

# Jira events over Pub/Sub (all optional; unset keeps /jira_webhook inline).
# Publisher: setting PUBSUB_TOPIC_ID makes /jira_webhook validate and queue events.
# PUBSUB_PROJECT_ID=
# PUBSUB_TOPIC_ID=
# PUBSUB_REGION=us-west1
# Consumer (`python -m jbi consume`):
# PUBSUB_SUBSCRIPTION_ID=
# Credentials accepted by /jira_webhook. A native Jira webhook signs deliveries
# with its secret (X-Hub-Signature); an Automation rule sends X-Api-Key.
# JBI_JIRA_WEBHOOK_SECRET=
# JBI_JIRA_WEBHOOK_SECRET_PREVIOUS=   # only while rotating
# JBI_JIRA_API_KEY=                   # falls back to JBI_API_KEY
# Shared duplicate-suppression ledger; unset uses an in-process one.
# Leave unset locally unless you have credentials or FIRESTORE_EMULATOR_HOST.
# FIRESTORE_DATABASE=
